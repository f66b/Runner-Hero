package oop.collections.tests;

import oop.utils.collections.ArrayList;
import oop.collections.ICollection;

public class AllTests {
	
	 private static void testEmptyConstructor() {
	        ArrayList list = new ArrayList();
	        assert list.length() == 0 : "Empty constructor should create list of length 0";
	        System.out.println("✓ Empty constructor test passed");
	    }

	    private static void testArrayConstructor() {
	        Object[] array = {"A", "B", "C"};
	        ArrayList list = new ArrayList(array);
	        assert list.length() == 3 : "Array constructor should create list of length 3";
	        assert list.elementAt(0).equals("A") : "First element should be 'A'";
	        assert list.elementAt(1).equals("B") : "Second element should be 'B'";
	        assert list.elementAt(2).equals("C") : "Third element should be 'C'";
	        System.out.println("✓ Array constructor test passed");
	    }

	    private static void testInsertAndRemove() {
	        ArrayList list = new ArrayList();
	        list.insertAt(0, "A");
	        list.insertAt(1, "B");
	        list.insertAt(1, "C");
	        
	        assert list.length() == 3 : "List should have length 3 after insertions";
	        assert list.elementAt(0).equals("A") : "First element should be 'A'";
	        assert list.elementAt(1).equals("C") : "Second element should be 'C'";
	        assert list.elementAt(2).equals("B") : "Third element should be 'B'";
	        
	        Object removed = list.removeAt(1);
	        assert removed.equals("C") : "Removed element should be 'C'";
	        assert list.length() == 2 : "List should have length 2 after removal";
	        assert list.elementAt(0).equals("A") : "First element should still be 'A'";
	        assert list.elementAt(1).equals("B") : "Second element should now be 'B'";
	        
	        System.out.println("✓ Insert and remove test passed");
	    }

	    private static void testIterator() {
	        ArrayList list = new ArrayList(new Object[]{"A", "B", "C"});
	        ICollection.Iterator it = list.iterator();
	        
	        assert it.hasNext() : "Iterator should have next element";
	        assert it.next().equals("A") : "First element should be 'A'";
	        assert it.hasNext() : "Iterator should have second element";
	        assert it.next().equals("B") : "Second element should be 'B'";
	        assert it.hasNext() : "Iterator should have third element";
	        assert it.next().equals("C") : "Third element should be 'C'";
	        assert !it.hasNext() : "Iterator should not have more elements";
	        
	        System.out.println("✓ Iterator test passed");
	    }

	    private static void testContainsAndRemoveElement() {
	        ArrayList list = new ArrayList(new Object[]{"A", "B", "C"});
	        
	        assert list.contains("B") : "List should contain 'B'";
	        assert !list.contains("D") : "List should not contain 'D'";
	        
	        boolean removed = list.remove("B");
	        assert removed : "Remove should return true for existing element";
	        assert !list.contains("B") : "List should not contain 'B' after removal";
	        assert list.length() == 2 : "List should have length 2 after removal";
	        
	        System.out.println("✓ Contains and remove element test passed");
	    }

	    private static void testGrowth() {
	        ArrayList list = new ArrayList();
	        // Insert 40 elements to test growth behavior
	        for (int i = 0; i < 40; i++) {
	            list.insertAt(i, i);
	        }
	        
	        assert list.length() == 40 : "List should have length 40";
	        for (int i = 0; i < 40; i++) {
	            assert list.elementAt(i).equals(i) : "Element at " + i + " should be " + i;
	        }
	        
	        System.out.println("✓ Growth test passed");
	    }

	    private static void testToArray() {
	        ArrayList list = new ArrayList(new Object[]{"A", "B", "C"});
	        Object[] array = new Object[3];
	        list.toArray(array);
	        
	        assert array[0].equals("A") : "First array element should be 'A'";
	        assert array[1].equals("B") : "Second array element should be 'B'";
	        assert array[2].equals("C") : "Third array element should be 'C'";
	        
	        System.out.println("✓ ToArray test passed");
	    }

	    public static void main(String[] args) {
	        try {
	            System.out.println("Running ArrayList tests...\n");
	            
	            testEmptyConstructor();
	            testArrayConstructor();
	            testInsertAndRemove();
	            testIterator();
	            testContainsAndRemoveElement();
	            testGrowth();
	            testToArray();
	            
	            System.out.println("\nAll tests passed successfully! ✓");
	        } catch (AssertionError e) {
	            System.err.println("\n❌ Test failed: " + e.getMessage());
	            System.exit(1);
	        } catch (Exception e) {
	            System.err.println("\n❌ Unexpected error: " + e.getMessage());
	            e.printStackTrace();
	            System.exit(1);
	        }
	    }

}
